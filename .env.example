# Copy this file to .env.local and set only what you use.
# Values saved on the Settings page take precedence over these.

# SQLite database location.  Defaults to .data/legislation.db.
# LEGISLATION_DB_PATH=.data/legislation.db

# Set to false to start with an empty watch list instead of the seeded Acts.
# SEED_DEFAULT_ACTS=true

# Change briefs from an OpenAI-compatible /chat/completions endpoint,
# such as a local Ollama, LM Studio or vLLM server.
# LLM_ENABLED=true
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024

# Change briefs from Claude through the Anthropic API.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# npm run check-all: post the digest to a webhook.
# DIGEST_WEBHOOK_URL=https://hooks.slack.com/services/...
# DIGEST_WEBHOOK_FORMAT=slack
